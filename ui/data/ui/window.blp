using Gtk 4.0;
using Adw 1;

template $ProtonDriveMainWindow: Adw.ApplicationWindow {
  title: "ProtonDrive";

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView nav_split_view {
    min-sidebar-width: 220;
    max-sidebar-width: 220;

    sidebar: Adw.NavigationPage {
      title: "Sync Pairs";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        [top]
        Adw.Banner session_expired_banner {
          title: _("Session expired — sign in to resume sync");
          revealed: false;
          button-label: _("Sign in");
          styles ["error"]
        }

        [top]
        Adw.Banner engine_crashed_banner {
          title: _("Sync engine stopped — restart to resume");
          revealed: false;
          button-label: _("Restart");
          styles ["error"]
        }

        content: Gtk.ScrolledWindow {
          child: Gtk.ListBox pairs_list {
            selection-mode: single;
          };
        };

        [bottom]
        Gtk.Button add_pair_button {
          label: _("+ Add Pair");
          margin-top: 4;
          margin-bottom: 4;
          margin-start: 8;
          margin-end: 8;
          sensitive: false;

          styles ["flat"]
        }

        [bottom]
        $ProtonDriveStatusFooterBar status_footer_bar {}
      };
    };

    content: Adw.NavigationPage {
      title: "Details";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: $ProtonDrivePairDetailPanel pair_detail_panel {};
      };
    };
    };
  };
}
